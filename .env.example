APP_NAME="Pacha Viva"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Lima

# F-1 (docs/lote-3/seguridad-2026-09-14.md): hosts adicionales aceptados por
# TrustHosts (bootstrap/app.php), aparte del host que sale de APP_URL. Deja
# vacío en producción si APP_URL ya es el dominio real; en local, agrega el
# vhost que sirve el sitio (Laragon: "tours-word.test"). Coma-separado.
EXTRA_TRUSTED_HOSTS=tours-word.test,127.0.0.1,localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Receta SEO `docs/rediseno-2026/02-seo.md` ## 6.2. SOLO en true en el .env
# del despliegue de demo en limaviewtours.com/tour-word/ (subdirectorio de
# OTRO cliente). NO es la misma bandera que "contenido de muestra del
# catálogo" (ver config/cms.php, catalog_demo_content): ese apaga cuando la
# clienta carga su catálogo real; esta apaga cuando el build deja el
# subdirectorio ajeno. Combinadas en App\Support\Indexability::siteIsIndexable()
# -- basta con que UNA no resuelva a "false" explícito para que el sitio
# entero salga noindex.
#
# FALLA CERRADA (hallazgo M-1, docs/rediseno-2026/04-seguridad.md ##5): el
# .env de producción REAL de Pacha Viva ya NO puede omitir esta variable --
# tiene que declarar IS_STAGING_MIRROR=false EXPLÍCITO. Si el deploy la
# pierde, hay un typo en el nombre, o queda vacía ("IS_STAGING_MIRROR="), el
# default ahora es noindex, no indexable -- a propósito: el default abierto
# anterior dejaba indexable un espejo de staging en el dominio de
# producción de otro cliente ante cualquier fallo silencioso de config.
IS_STAGING_MIRROR=false

# PUBLIC_STORAGE_URL (docs/rediseno-2026/15-urls-imagenes-subdirectorio.md):
# de dónde salen las URL de las imágenes del CMS (config/filesystems.php,
# disco "public"). Deja esta variable AUSENTE (no la declares ni la dejes
# vacía) en local y en la producción real futura de Pacha Viva en la raíz
# del dominio -- el default sin ella es "/storage", idéntico a como está
# hoy. SOLO se declara, con este valor exacto, en el .env del despliegue de
# demo en el subdirectorio ajeno (limaviewtours.com/tour-word/):
#
#   PUBLIC_STORAGE_URL=/tour-word/public/storage
#
# Va en el .env del servidor ANTES de correr `config:cache` (mismo orden que
# IS_STAGING_MIRROR arriba) -- si se cachea sin esta línea, o con el nombre
# mal escrito, la config vieja ("/storage") queda congelada en silencio y las
# fotos del catálogo vuelven a dar 403.
# PUBLIC_STORAGE_URL=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pachaviva
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=-05:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Inbox that receives "new /contacto message" notifications. Separate from
# the public-facing Setting "contact_email" edited in Configuración.
# O-2 (docs/lote-3/seguridad-2026-09-14.md): FAILS CLOSED if empty -- the
# message from the form is still saved, but NO notification is sent to
# anyone (never a default recipient, never MAIL_FROM_ADDRESS). Set this
# before relying on email notifications in any environment.
CONTACT_NOTIFY_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
